# syntax=docker/dockerfile:1

ARG UBUNTU_VERSION=24.04
FROM arm64v8/ubuntu:${UBUNTU_VERSION}

ARG DEBIAN_FRONTEND=noninteractive
ARG NVM_VERSION=0.40.6
ARG NODE_VERSION=24.18.0
ARG GO_VERSION=1.26.5
ARG GO_SHA256=fe4789e92b1f33358680864bbe8704289e7bb5fc207d80623c308935bd696d49
ARG MAVEN_VERSION=3.9.16
ARG MAVEN_SHA512=831a8591fe20c8243b1dbe7d71e3244f31d1665b0804b2e825e38cbbe5ce0cafb8338851f90780735568773e0a6cd07bbec107cda0b896b008b861075358b6f6
ARG GRADLE_VERSION=9.6.1
ARG GRADLE_SHA256=9c0f7faeeb306cb14e4279a3e084ca6b596894089a0638e68a07c945a32c9e14
ARG KAFKA_VERSION=4.3.1
ARG KAFKA_SHA512=C7D7B2318CB51AA0C61D3246A51C349210073C5C9B754947EF965A439F2F939E8600F204E134A75AC31FAF3829C9370960EF7C6A9886C8A1DBF0339A21F4C54C
ARG CDK8S_CLI_VERSION=2.207.45
ARG AWS_CDK_VERSION=2.1135.0
ARG TYPESCRIPT_VERSION=7.0.2
ARG TYPESCRIPT_LANGUAGE_SERVER_VERSION=5.3.0
ARG CODEX_VERSION=0.146.0
ARG CLAUDE_CODE_VERSION=2.1.220
ARG GIT_USER_EMAIL=john.davis@cantina.ai
ARG GIT_USER_NAME="John Davis"

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

ENV NVM_DIR=/root/.nvm \
    SDKMAN_DIR=/root/.sdkman

# Core development and SSH packages.
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        autoconf \
        automake \
        bash-completion \
        build-essential \
        ca-certificates \
        ccache \
        clang \
        curl \
        dnsutils \
        emacs-nox \
        git \
        git-lfs \
        gnupg \
        groff \
        iputils-ping \
        java-common \
        jq \
        less \
        libboost-all-dev \
        libjemalloc-dev \
        libssl-dev \
        libtool \
        net-tools \
        netcat-openbsd \
        ninja-build \
        openssh-server \
        openssl \
        python-is-python3 \
        python3 \
        python3-pip \
        ripgrep \
        universal-ctags \
        unzip \
        yasm \
        zip \
        zlib1g-dev && \
    rm -rf /var/lib/apt/lists/*

# Add vendor repositories for tools that are newer than Ubuntu's packages.
RUN install -m 0755 -d /etc/apt/keyrings && \
    curl -fsSL https://download.docker.com/linux/ubuntu/gpg \
        -o /etc/apt/keyrings/docker.asc && \
    curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
        -o /etc/apt/keyrings/github-cli.gpg && \
    curl -fsSL https://apt.releases.hashicorp.com/gpg | \
        gpg --batch --dearmor -o /etc/apt/keyrings/hashicorp.gpg && \
    curl -fsSL https://apt.kitware.com/keys/kitware-archive-latest.asc | \
        gpg --batch --dearmor -o /etc/apt/keyrings/kitware.gpg && \
    curl -fsSL https://apt.corretto.aws/corretto.key | \
        gpg --batch --dearmor -o /etc/apt/keyrings/corretto.gpg && \
    chmod a+r /etc/apt/keyrings/* && \
    source /etc/os-release && \
    repository_arch="$(dpkg --print-architecture)" && \
    printf 'deb [arch=%s signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/ubuntu %s stable\n' \
        "${repository_arch}" "${VERSION_CODENAME}" \
        > /etc/apt/sources.list.d/docker.list && \
    printf 'deb [arch=%s signed-by=/etc/apt/keyrings/github-cli.gpg] https://cli.github.com/packages stable main\n' \
        "${repository_arch}" \
        > /etc/apt/sources.list.d/github-cli.list && \
    printf 'deb [arch=%s signed-by=/etc/apt/keyrings/hashicorp.gpg] https://apt.releases.hashicorp.com %s main\n' \
        "${repository_arch}" "${VERSION_CODENAME}" \
        > /etc/apt/sources.list.d/hashicorp.list && \
    printf 'deb [arch=%s signed-by=/etc/apt/keyrings/kitware.gpg] https://apt.kitware.com/ubuntu/ %s main\n' \
        "${repository_arch}" "${VERSION_CODENAME}" \
        > /etc/apt/sources.list.d/kitware.list && \
    printf 'deb [arch=%s signed-by=/etc/apt/keyrings/corretto.gpg] https://apt.corretto.aws stable main\n' \
        "${repository_arch}" \
        > /etc/apt/sources.list.d/corretto.list && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
        cmake \
        docker-buildx-plugin \
        docker-ce-cli \
        docker-compose-plugin \
        gh \
        java-21-amazon-corretto-jdk \
        terraform && \
    rm -rf /var/lib/apt/lists/*

RUN git config --global user.email "${GIT_USER_EMAIL}" && \
    git config --global user.name "${GIT_USER_NAME}"

# Install Deno and Rust.
RUN curl --proto '=https' --tlsv1.2 -fsSL https://deno.land/install.sh | sh && \
    install -m 0755 /root/.deno/bin/deno /usr/local/bin/deno && \
    rm -rf /root/.deno

RUN curl --proto '=https' --tlsv1.2 -fsSL https://sh.rustup.rs | sh -s -- -y

# Install Node through NVM once, then expose the default version to all processes.
RUN git clone --depth 1 --branch "v${NVM_VERSION}" https://github.com/nvm-sh/nvm.git "${NVM_DIR}" && \
    source "${NVM_DIR}/nvm.sh" && \
    nvm install "${NODE_VERSION}" && \
    nvm alias default "${NODE_VERSION}" && \
    ln -s "${NVM_DIR}/versions/node/v${NODE_VERSION}" /opt/node && \
    rm -rf "${NVM_DIR}/.git"

ENV PATH="/opt/node/bin:/root/.cargo/bin:${PATH}"

RUN npm install -g \
        "cdk8s-cli@${CDK8S_CLI_VERSION}" \
        "aws-cdk@${AWS_CDK_VERSION}" \
        "typescript@${TYPESCRIPT_VERSION}" \
        "typescript-language-server@${TYPESCRIPT_LANGUAGE_SERVER_VERSION}" \
        "@openai/codex@${CODEX_VERSION}" \
        "@anthropic-ai/claude-code@${CLAUDE_CODE_VERSION}" && \
    npm cache clean --force

# Install AWS and remote-access utilities.
WORKDIR /tmp
RUN curl -fsSL https://awscli.amazonaws.com/awscli-exe-linux-aarch64.zip -o awscliv2.zip && \
    unzip -q awscliv2.zip && \
    ./aws/install && \
    rm -rf awscliv2.zip aws

RUN curl -fsSL \
        https://s3.amazonaws.com/session-manager-downloads/plugin/latest/ubuntu_arm64/session-manager-plugin.deb \
        -o session-manager-plugin.deb && \
    dpkg -i session-manager-plugin.deb && \
    rm -f session-manager-plugin.deb

RUN curl -fsSL \
        https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-linux-arm64.deb \
        -o cloudflared.deb && \
    dpkg -i cloudflared.deb && \
    rm -f cloudflared.deb

# Install current JVM build tools with verified archives.
RUN maven_archive="apache-maven-${MAVEN_VERSION}-bin.tar.gz" && \
    curl -fsSL \
        "https://archive.apache.org/dist/maven/maven-3/${MAVEN_VERSION}/binaries/${maven_archive}" \
        -o "${maven_archive}" && \
    printf '%s  %s\n' "${MAVEN_SHA512}" "${maven_archive}" | sha512sum -c - && \
    install -d /opt/maven && \
    tar -xzf "${maven_archive}" -C /opt/maven && \
    ln -s "/opt/maven/apache-maven-${MAVEN_VERSION}" /opt/maven/latest && \
    rm -f "${maven_archive}"

RUN gradle_archive="gradle-${GRADLE_VERSION}-bin.zip" && \
    curl -fsSL \
        "https://services.gradle.org/distributions/${gradle_archive}" \
        -o "${gradle_archive}" && \
    printf '%s  %s\n' "${GRADLE_SHA256}" "${gradle_archive}" | sha256sum -c - && \
    install -d /opt/gradle && \
    unzip -q "${gradle_archive}" -d /opt/gradle && \
    ln -s "/opt/gradle/gradle-${GRADLE_VERSION}" /opt/gradle/latest && \
    rm -f "${gradle_archive}"

# Install Kotlin through SDKMAN so it can be managed independently.
RUN curl -fsSL https://get.sdkman.io | bash && \
    source "${SDKMAN_DIR}/bin/sdkman-init.sh" && \
    sdk install kotlin

# Install Go with the upstream checksum.
RUN go_archive="go${GO_VERSION}.linux-arm64.tar.gz" && \
    curl -fsSL "https://go.dev/dl/${go_archive}" -o "${go_archive}" && \
    printf '%s  %s\n' "${GO_SHA256}" "${go_archive}" | sha256sum -c - && \
    rm -rf /usr/local/go && \
    tar -xzf "${go_archive}" -C /usr/local && \
    rm -f "${go_archive}"

# Keep the historical CMake path expected by media tooling.
COPY cmake-wrapper.sh /usr/local/bin/cmake-wrapper
RUN chmod 0755 /usr/local/bin/cmake-wrapper && \
    install -d /opt/media-tools-bin/linux/cmake/3.26.4/bin && \
    ln -s /usr/local/bin/cmake-wrapper \
        /opt/media-tools-bin/linux/cmake/3.26.4/bin/cmake && \
    /opt/media-tools-bin/linux/cmake/3.26.4/bin/cmake --version

ENV CMAKE_COMMAND=/usr/bin/cmake

# Install Kafka command-line tools with the upstream checksum.
RUN kafka_archive="kafka_2.13-${KAFKA_VERSION}.tgz" && \
    curl -fsSL \
        "https://archive.apache.org/dist/kafka/${KAFKA_VERSION}/${kafka_archive}" \
        -o "${kafka_archive}" && \
    printf '%s  %s\n' "${KAFKA_SHA512}" "${kafka_archive}" | sha512sum -c - && \
    tar -xzf "${kafka_archive}" -C /opt && \
    ln -s "/opt/kafka_2.13-${KAFKA_VERSION}" /opt/kafka && \
    rm -f "${kafka_archive}"

ENV PATH="/usr/local/go/bin:/opt/maven/latest/bin:/opt/gradle/latest/bin:/opt/kafka/bin:${PATH}"

RUN printf '%s\n' \
        'export PATH="/usr/local/go/bin:/opt/maven/latest/bin:/opt/gradle/latest/bin:/opt/kafka/bin:/opt/node/bin:/root/.cargo/bin:$PATH"' \
        > /etc/profile.d/dev-tools.sh && \
    printf '%s\n' \
        'export NVM_DIR="/root/.nvm"' \
        'if [ -s "$NVM_DIR/nvm.sh" ]; then' \
        '    . "$NVM_DIR/nvm.sh"' \
        '    nvm deactivate --silent >/dev/null 2>&1 || true' \
        '    nvm use --silent default >/dev/null' \
        'fi' \
        'case $- in *i*) [ -s "$NVM_DIR/bash_completion" ] && . "$NVM_DIR/bash_completion" ;; esac' \
        > /etc/profile.d/nvm.sh && \
    chmod 0644 /etc/profile.d/dev-tools.sh /etc/profile.d/nvm.sh && \
    terraform -install-autocomplete

# Preserve the existing helper scripts for cloning private repositories.
WORKDIR /root/repo/dev
RUN printf '%s\n' \
        '#!/bin/sh' \
        'exec git clone git@github.com:airtimemedia/shasta.git' \
        > clone.shasta.sh && \
    printf '%s\n' \
        '#!/bin/sh' \
        'exec git clone git@github.com:unicomp23/omni.git' \
        > clone.omni.sh && \
    chmod 0755 clone.shasta.sh clone.omni.sh

RUN curl -fsSL \
        https://raw.githubusercontent.com/jb55/typescript-ctags/master/.ctags \
        -o /root/.ctags && \
    printf '%s\n' '(setq make-backup-files nil)' > /root/.emacs

# Keep password-based root SSH access and initialize every SSH shell consistently.
RUN install -d -m 0755 /run/sshd && \
    ssh-keygen -A && \
    echo 'root:pwd' | chpasswd && \
    printf '%s\n' \
        '. /etc/profile.d/dev-tools.sh' \
        '[ -s "/root/.sdkman/bin/sdkman-init.sh" ] && . "/root/.sdkman/bin/sdkman-init.sh"' \
        '. /etc/profile.d/nvm.sh' \
        > /etc/ssh/shasta.bash_env && \
    sed -i '/#THIS MUST BE AT THE END OF THE FILE FOR SDKMAN TO WORK!!!/,+2d' \
        /root/.bashrc && \
    sed -i '1i. /etc/ssh/shasta.bash_env' /root/.bashrc && \
    printf '%s\n' \
        'PasswordAuthentication yes' \
        'PermitRootLogin yes' \
        'SetEnv SSH_AUTH_SOCK=/ssh-agent' \
        > /etc/ssh/sshd_config.d/99-shasta.conf && \
    rm -f /etc/ssh/sshrc && \
    chmod 0644 \
        /etc/ssh/shasta.bash_env \
        /etc/ssh/sshd_config.d/99-shasta.conf && \
    /usr/sbin/sshd -t

# Build-time smoke test for the complete command-line environment.
RUN source /etc/profile.d/nvm.sh && \
    source "${SDKMAN_DIR}/bin/sdkman-init.sh" && \
    python --version && \
    node --version && \
    npm --version && \
    nvm --version && \
    codex --version && \
    claude --version && \
    gh --version | head -n 1 && \
    deno --version | head -n 1 && \
    rustc --version && \
    go version && \
    java -version && \
    mvn --version | head -n 1 && \
    gradle --version | sed -n '/^Gradle /p' && \
    kotlin -version && \
    docker --version && \
    docker compose version && \
    docker buildx version && \
    aws --version && \
    cloudflared --version && \
    terraform version | head -n 1 && \
    cmake --version | head -n 1 && \
    kafka-topics.sh --version

EXPOSE 22

CMD ["/usr/sbin/sshd", "-D", "-e"]
